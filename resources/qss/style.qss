/* HMI-T113S4 — 800x480 触摸界面
   字体族不在此硬编码：全局 QFont 按 ui/fontSize(默认 17px) 设置，
   中文由 rootfs 的 wqy-zenhei + fontconfig 解析。
   字号一律用 px，不用 pt：pt 会随屏幕物理 DPI 换算，
   板端 7 寸屏（约 130-190dpi）上 14pt 会变成 37px，直接撑破固定 px 的控件。
   尺寸与 widgets/uimetrics.h 一一对应，改一处记得同步另一边：
     NavItemHeight 44 / ButtonHeight 42 / LogHeight 114(紧凑 84) / StatusBarHeight 30
     TitlePixelSize 22 / TextPixelSize 17 / HintPixelSize 15 / StatusPixelSize 16 / LogPixelSize 12 */

/* ---- 软键盘（纯 QWidget，贴底停靠）----
   键高/间距与 widgets/uimetrics.h 的 SoftKeyHeight / SoftKeySpacing 对应：
   40px 高，4 行 + 3 道间距 + 上下边距 8 = 185px */
#softKeyboard {
    background-color: #E8EDF5;
    border-top: 2px solid #4187F0;
}
#softKeyboard QPushButton#softKey {
    background-color: #FFFFFF;
    color: #2F3A4A;
    border: 1px solid #C8D5EA;
    border-radius: 5px;
    font-size: 18px;
}
#softKeyboard QPushButton#softKey:pressed { background-color: #DCE8FA; }
#softKeyboard QPushButton#softKeyAccent {
    background-color: #D7E0EE;
    color: #2F3A4A;
    border: 1px solid #BCC9DD;
    border-radius: 5px;
    font-size: 16px;
}
#softKeyboard QPushButton#softKeyAccent:pressed { background-color: #C3CFE2; }
#softKeyboard QPushButton#softKeyPrimary {
    background-color: #4187F0;
    color: #FFFFFF;
    border: 1px solid #2F6FD0;
    border-radius: 5px;
    font-size: 16px;
    font-weight: bold;
}
#softKeyboard QPushButton#softKeyPrimary:pressed { background-color: #2F6FD0; }

/* 全局有一条 16px 宽的滚动条规则，键盘区域不需要，免得挤掉键宽 */
#softKeyboard QScrollBar { width: 0px; height: 0px; }

#centralRoot { background-color: #F4F6FA; }

/* 页面滚动区透明：否则内容不满一屏时下半部会露出一大块白色 viewport，
   和页面底色割裂，看起来像"空了一块" */
#basePage QScrollArea,
#basePage QScrollArea > QWidget > QWidget { background: transparent; border: none; }

#navPanel { background-color: #2F3A4A; }

#navToggle {
    background-color: #3C4A5E;
    color: #DCE6F5;
    border: none;
    border-radius: 4px;
    font-size: 20px;
}
#navToggle:hover { background-color: #46566D; }
#navToggle:pressed { background-color: #4187F0; color: #FFFFFF; }

#navList {
    background-color: transparent;
    color: #DCE6F5;
    font-size: 17px;
    border: none;
    outline: none;
}
#navList::item {
    height: 44px;
    padding-left: 10px;
    border-radius: 4px;
    margin-bottom: 2px;
}
#navList::item:hover { background-color: #3C4A5E; }
#navList::item:selected { background-color: #4187F0; color: #FFFFFF; }
#navList::item:focus { border: none; outline: none; }

/* 导航自己的滚动条：全局那条 16px 宽、带上下箭头，在 56px 收起态里会吃掉半个字宽 */
#navList QScrollBar:vertical {
    width: 8px;
    background: transparent;
    margin: 0;
}
#navList QScrollBar::handle:vertical {
    min-height: 28px;
    background: #55637A;
    border-radius: 3px;
}
#navList QScrollBar::add-line:vertical,
#navList QScrollBar::sub-line:vertical { height: 0px; background: transparent; }
#navList QScrollBar::add-page:vertical,
#navList QScrollBar::sub-page:vertical { background: transparent; }

#pageTitle   { color: #2F3A4A; font-size: 22px; font-weight: bold; }
#pageIntro   { color: #3C4457; font-size: 16px; }
#sysInfo     { color: #3C4457; font-size: 16px; background: #FFFFFF;
               border: 1px solid #C8D5EA; border-radius: 4px; padding: 8px; }
#pageStatus  { color: #1E8E3E; font-size: 16px; }

#pageHint {
    background-color: #FFF6E0;
    border: 1px solid #E8C877;
    border-radius: 4px;
    color: #7A5B00;
    font-size: 15px;
    padding: 6px 8px;
}

#videoPlaceholder {
    background-color: #20262F;
    border: 1px solid #4A5568;
    border-radius: 4px;
}
/* 子 QLabel 的 color 不会从父控件继承，必须单列一条，否则深底上几乎看不见 */
#videoPlaceholderText { color: #D5E2F5; font-size: 16px; background: transparent; }

#upgradeProgress {
    min-height: 18px; max-height: 18px;
    border: 1px solid #C8D5EA;
    border-radius: 4px;
    background: #FFFFFF;
    text-align: center;
    color: #2F3A4A;
    font-size: 12px;
}
#upgradeProgress::chunk { background: #4187F0; border-radius: 3px; }

#logPanel { background-color: transparent; }
#logTitle { color: #5A6474; font-size: 14px; }
#logView  { background-color: #FFFFFF; color: #2F3A4A;
            border: 1px solid #C8D5EA; border-radius: 4px; font-size: 12px; }
#logClearButton {
    min-height: 28px; max-height: 28px; max-width: 76px;
    background-color: #EEF2F7; color: #2F3A4A;
    border: 1px solid #C8D5EA; border-radius: 4px; font-size: 12px;
}
#logClearButton:pressed { background-color: #DCE8FA; }

QLineEdit, QComboBox, QSpinBox {
    min-height: 34px;
    max-height: 38px;
    font-size: 16px;
    color: #3C4457;
    background-color: #FFFFFF;
    border: 1px solid #C8D5EA;
    border-radius: 4px;
    padding: 0 8px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 2px solid #4187F0; }
QComboBox::drop-down { width: 30px; border-left: 1px solid #C8D5EA; }
QComboBox QAbstractItemView { min-height: 30px; font-size: 16px; selection-background-color: #4187F0; }
QSpinBox::up-button, QSpinBox::down-button { width: 30px; }

QPlainTextEdit {
    font-size: 14px;
    color: #3C4457;
    background-color: #FFFFFF;
    border: 1px solid #C8D5EA;
    border-radius: 4px;
}

QSlider { min-height: 30px; }
QSlider::groove:horizontal { height: 6px; background: #C8D5EA; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #4187F0; border-radius: 3px; }
QSlider::handle:horizontal {
    width: 22px; height: 22px; margin: -8px 0;
    background: #FFFFFF; border: 2px solid #4187F0; border-radius: 11px;
}

QStatusBar, #statusBar {
    background-color: #EEF2F7;
    border-top: 1px solid #C8D5EA;
    color: #2F3A4A;
    font-size: 14px;
}
QStatusBar::item { border: none; }
#clockLabel { color: #2F3A4A; font-size: 14px; padding-right: 8px; }

QScrollBar:vertical { width: 16px; background: transparent; margin: 12px 0 12px 0; }
QScrollBar::handle:vertical { min-height: 28px; background: #C8D5EA; border-radius: 7px; }
QScrollBar::sub-line:vertical {
    height: 12px; subcontrol-position: top; subcontrol-origin: margin;
    image: url(:/image/Icon/common/up_arrow.png);
}
QScrollBar::add-line:vertical {
    height: 12px; subcontrol-position: bottom; subcontrol-origin: margin;
    image: url(:/image/Icon/common/down_arrow.png);
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal { height: 16px; background: transparent; margin: 0 12px 0 12px; }
QScrollBar::handle:horizontal { min-width: 28px; background: #C8D5EA; border-radius: 7px; }
QScrollBar::sub-line:horizontal {
    width: 12px; subcontrol-position: left; subcontrol-origin: margin;
    image: url(:/image/Icon/common/left_arrow.png);
}
QScrollBar::add-line:horizontal {
    width: 12px; subcontrol-position: right; subcontrol-origin: margin;
    image: url(:/image/Icon/common/right_arrow.png);
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
