/* HMI-T113S4 — 1024x600 触摸界面
   字体族不在此硬编码：全局 QFont 只设 16pt，中文由 rootfs 的 wqy-zenhei + fontconfig 解析。 */

#centralRoot { background-color: #F4F6FA; }

#navPanel { background-color: #2F3A4A; }

#navList {
    background-color: transparent;
    color: #DCE6F5;
    font-size: 16pt;
    border: none;
    outline: none;
}
#navList::item {
    height: 56px;
    padding-left: 12px;
    border-radius: 4px;
    margin-bottom: 4px;
}
#navList::item:hover { background-color: #3C4A5E; }
#navList::item:selected { background-color: #4187F0; color: #FFFFFF; }

#pageTitle   { color: #2F3A4A; font-size: 20pt; font-weight: bold; }
#pageIntro   { color: #3C4457; font-size: 16pt; }
#sysInfo     { color: #3C4457; font-size: 16pt; background: #FFFFFF;
               border: 1px solid #C8D5EA; border-radius: 4px; padding: 10px; }
#pageStatus  { color: #1E8E3E; font-size: 16pt; }

#pageHint {
    background-color: #FFF6E0;
    border: 1px solid #E8C877;
    border-radius: 4px;
    color: #7A5B00;
    font-size: 14pt;
    padding: 8px 10px;
}

#videoPlaceholder {
    background-color: #20262F;
    border: 1px solid #4A5568;
    border-radius: 4px;
    color: #C8D5EA;
    font-size: 16pt;
}

#logPanel { background-color: transparent; }
#logTitle { color: #2F3A4A; font-size: 13pt; text-align: left; }
#logView  { background-color: #FFFFFF; color: #2F3A4A;
            border: 1px solid #C8D5EA; border-radius: 4px; font-size: 12pt; }
#logClearButton {
    min-height: 56px; max-width: 160px;
    background-color: #EEF2F7; color: #2F3A4A;
    border: 1px solid #C8D5EA; border-radius: 4px; font-size: 15pt;
}
#logClearButton:pressed { background-color: #DCE8FA; }

QLineEdit, QComboBox, QSpinBox {
    min-height: 56px;
    max-height: 64px;
    font-size: 16pt;
    color: #3C4457;
    background-color: #FFFFFF;
    border: 1px solid #C8D5EA;
    border-radius: 4px;
    padding: 0 10px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 2px solid #4187F0; }
QComboBox::drop-down { width: 44px; border-left: 1px solid #C8D5EA; }
QComboBox QAbstractItemView { min-height: 44px; font-size: 16pt; selection-background-color: #4187F0; }
QSpinBox::up-button, QSpinBox::down-button { width: 44px; }

QPlainTextEdit {
    font-size: 12pt;
    color: #3C4457;
    background-color: #FFFFFF;
    border: 1px solid #C8D5EA;
    border-radius: 4px;
}

QSlider { min-height: 48px; }
QSlider::groove:horizontal { height: 8px; background: #C8D5EA; border-radius: 4px; }
QSlider::sub-page:horizontal { background: #4187F0; border-radius: 4px; }
QSlider::handle:horizontal {
    width: 32px; height: 32px; margin: -12px 0;
    background: #FFFFFF; border: 2px solid #4187F0; border-radius: 16px;
}

QStatusBar, #statusBar {
    background-color: #EEF2F7;
    border-top: 1px solid #C8D5EA;
    color: #2F3A4A;
    font-size: 13pt;
}
QStatusBar::item { border: none; }
#clockLabel { color: #2F3A4A; font-size: 13pt; padding-right: 12px; }

QScrollBar:vertical { width: 22px; background: transparent; margin: 16px 0 16px 0; }
QScrollBar::handle:vertical { min-height: 40px; background: #C8D5EA; border-radius: 8px; }
QScrollBar::sub-line:vertical {
    height: 16px; subcontrol-position: top; subcontrol-origin: margin;
    image: url(:/image/Icon/common/up_arrow.png);
}
QScrollBar::add-line:vertical {
    height: 16px; subcontrol-position: bottom; subcontrol-origin: margin;
    image: url(:/image/Icon/common/down_arrow.png);
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal { height: 22px; background: transparent; margin: 0 16px 0 16px; }
QScrollBar::handle:horizontal { min-width: 40px; background: #C8D5EA; border-radius: 8px; }
QScrollBar::sub-line:horizontal {
    width: 16px; subcontrol-position: left; subcontrol-origin: margin;
    image: url(:/image/Icon/common/left_arrow.png);
}
QScrollBar::add-line:horizontal {
    width: 16px; subcontrol-position: right; subcontrol-origin: margin;
    image: url(:/image/Icon/common/right_arrow.png);
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
